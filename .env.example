# Copy to .env and adjust. .env is git-ignored and must never be committed.

# ---- Core (required) ----
NODE_ENV=development
PORT=3000
# Every link in every email is built from this. Getting it wrong breaks all of them.
APP_URL=http://localhost:5173
# connection_limit should exceed the number of requests you expect to be in
# flight at once. An interactive transaction holds its connection for its whole
# duration, so a small pool turns contention into timeouts.
DATABASE_URL=postgresql://roombook:roombook_dev@localhost:5432/roombook?schema=public&connection_limit=20&pool_timeout=20
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=change-me-to-32-random-bytes-base64-encoded

# ---- Server clock ----
# Leave as UTC. Display zones come from the data, not the host clock, and this
# makes an accidental local-time call fail loudly in tests (NFR-11).
TZ=UTC

# ---- Email ----
# smtp | console   ("console" is refused when NODE_ENV=production)
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=RoomBook
MAIL_FROM_ADDRESS=rooms@acme.test

# ---- Logging ----
LOG_LEVEL=debug

# ---- Workers ----
# Set false on additional instances so the workers stay single-instance (A6).
WORKERS_ENABLED=true
OUTBOX_POLL_MS=15000
REMINDER_POLL_MS=60000

# ---- Recurrence (docs/12-recurrence.md) ----
RECURRENCE_HORIZON_DAYS=365
RECURRENCE_MAX_OCCURRENCES=500

# ---- Calendar sync (docs/13-calendar-sync.md) ----
# Ships OFF. Enable per organization once the .ics path is proven.
CALENDAR_SYNC_ENABLED=false
# 32-byte base64 key, stored OUTSIDE the database. Losing it forces everyone
# to reconnect their calendar.
CALENDAR_TOKEN_KEY=
CALENDAR_TOKEN_KEY_PREVIOUS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
# Must be publicly reachable over HTTPS; providers will not deliver to localhost.
# Use a tunnel (cloudflared/ngrok) when developing against real providers.
CALENDAR_WEBHOOK_BASE_URL=
CALENDAR_SYNC_POLL_MS=10000
CALENDAR_RECONCILE_HOURS=6

# ---- Proxy ----
# Hops to trust for the client IP. Must match your reverse proxy or the rate
# limiter will see every request as coming from the proxy.
TRUST_PROXY=1
